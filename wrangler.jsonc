{
  "$schema": "https://developers.cloudflare.com/workers/wrangler/config-schema.json",
  "name": "grabzone",
  "main": "./marketplace-stable-entry.mjs",
  "compatibility_date": "2026-08-28",
  "keep_vars": true,
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    // Serve the branded 404.html (HTTP 404) for every unmatched path. Paths
    // outside run_worker_first are answered by the asset binding before the
    // Worker runs, so without this they return an empty body.
    "not_found_handling": "404-page",
    "run_worker_first": ["/", "/marketplace", "/*.html", "/api/*"]
  },
  "d1_databases": [{
    "binding": "DB",
    "database_name": "grabzone-db-test",
    "database_id": "ffaa2c49-c89e-439f-9a71-89144b07dfce"
  }],
  "r2_buckets": [{
    "binding": "ASSETS_BUCKET",
    "bucket_name": "grabzone-assets"
  }],
  "observability": {"enabled": true}
}
